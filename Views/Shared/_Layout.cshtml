<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>@ViewData["Title"] · Campus Connect</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">
    <link href="https://fonts.googleapis.com/css2?family=DM+Sans:wght@400;500;600;700&family=Manrope:wght@500;600;700;800&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
</head>
<body>
<nav class="navbar navbar-expand-lg navbar-light bg-white border-bottom sticky-top">
 <div class="container">
  <a class="navbar-brand fw-bold" asp-controller="Home" asp-action="Index"><span class="brand-mark">C</span> Campus<span class="brand-accent">Connect</span></a>
  <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#nav"><span class="navbar-toggler-icon"></span></button>
  <div class="collapse navbar-collapse" id="nav">
   <ul class="navbar-nav me-auto ms-lg-4">
    <li class="nav-item"><a class="nav-link" asp-controller="Community" asp-action="Index">Community</a></li>
    <li class="nav-item"><a class="nav-link" asp-controller="Resources" asp-action="Index">Resources</a></li>
    <li class="nav-item"><a class="nav-link" asp-controller="Events" asp-action="Index">Events</a></li>
    <li class="nav-item"><a class="nav-link" asp-controller="Teams" asp-action="Index">Team Finder</a></li>
    <li class="nav-item"><a class="nav-link" asp-controller="LostFound" asp-action="Index">Lost & Found</a></li>
   </ul>
   <div class="d-flex align-items-center gap-2">
    @if (User.Identity?.IsAuthenticated == true) {
      <a class="btn btn-light btn-sm" asp-controller="Profile" asp-action="Index">My profile</a>
      @if (User.IsInRole("Admin")) { <a class="btn btn-outline-primary btn-sm" asp-controller="Admin" asp-action="Index">Admin</a> }
      <form asp-area="Identity" asp-page="/Account/Logout" asp-route-returnUrl="/" method="post"><button class="btn btn-dark btn-sm">Sign out</button></form>
    } else {
      <a class="btn btn-light btn-sm" asp-area="Identity" asp-page="/Account/Login">Sign in</a>
      <a class="btn btn-primary btn-sm" asp-area="Identity" asp-page="/Account/Register">Join campus</a>
    }
   </div>
  </div>
 </div>
</nav>
<main class="container py-4">
 @if (TempData["Notice"] != null) { <div class="alert alert-success alert-dismissible fade show">@TempData["Notice"]<button type="button" class="btn-close" data-bs-dismiss="alert"></button></div> }
 @RenderBody()
</main>
<footer class="container footer mt-5 py-4"><div class="d-flex justify-content-between flex-wrap gap-2"><span>© @DateTime.Now.Year Campus Connect</span><span>One campus. More possibilities.</span></div></footer>
<script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
@await RenderSectionAsync("Scripts", required: false)
</body></html>
