
@if (User.Identity?.IsAuthenticated == true)
{
    <form class="d-inline"
          asp-area="Identity"
          asp-page="/Account/Logout"
          asp-route-returnUrl="/"
          method="post">
        <button type="submit" class="btn btn-link nav-link">
            Logout
        </button>
    </form>
}
else
{
    <a class="nav-link"
       asp-area="Identity"
       asp-page="/Account/Register">
        Register
    </a>

    <a class="nav-link"
       asp-area="Identity"
       asp-page="/Account/Login">
        Login
    </a>
}
