@model IEnumerable<CampusPost>
@{ ViewData["Title"] = "Community"; }
<div class="page-head"><div><div class="eyebrow">STUDENT VOICES</div><h1>Community</h1><p>Ask, share, discuss and learn from your campus.</p></div><a class="btn btn-primary" asp-action="Create">＋ Create post</a></div>
<form class="searchbar mb-4"><input name="q" value="@ViewBag.Query" placeholder="Search conversations..." /><button class="btn btn-dark">Search</button></form>
@foreach(var p in Model) { <article class="content-card mb-3"><div class="d-flex justify-content-between"><span class="pill">@p.Category</span><small class="muted">@p.CreatedAt.ToLocalTime().ToString("dd MMM yyyy")</small></div><h4 class="mt-3">@p.Title</h4><p class="post-body">@p.Body</p><div class="d-flex justify-content-between align-items-center"><small class="muted">By @p.AuthorName · @p.Likes likes</small><div class="d-flex gap-2"><form asp-action="Like" method="post"><input type="hidden" name="id" value="@p.Id"/><button class="btn btn-sm btn-light">♡ Like</button></form>@if(User.IsInRole("Admin") || p.UserId == User.FindFirst(System.Security.Claims.ClaimTypes.NameIdentifier)?.Value) { <form asp-action="Delete" method="post"><input type="hidden" name="id" value="@p.Id"/><button class="btn btn-sm btn-outline-danger">Delete</button></form> }</div></div></article> }
@if(!Model.Any()) { <div class="empty-card">No posts found. Start the first conversation.</div> }
