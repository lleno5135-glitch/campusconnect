@model TeamInput
@{ ViewData["Title"] = "Create project listing"; }
<div class="form-shell"><div class="eyebrow">FIND YOUR CREW</div><h1>Post a project</h1><form method="post"><label asp-for="ProjectTitle" class="form-label"></label><input asp-for="ProjectTitle" class="form-control mb-3"/><label asp-for="Description" class="form-label"></label><textarea asp-for="Description" class="form-control mb-3"></textarea><label asp-for="RequiredSkills" class="form-label">Required skills (comma separated)</label><input asp-for="RequiredSkills" class="form-control mb-3" placeholder="C#, UI design, SQL"/><label asp-for="Department" class="form-label"></label><input asp-for="Department" class="form-control mb-3"/><label asp-for="MembersNeeded" class="form-label"></label><input asp-for="MembersNeeded" class="form-control mb-3"/><button class="btn btn-primary">Publish project</button></form></div>
