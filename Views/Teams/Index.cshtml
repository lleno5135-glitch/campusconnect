@model IEnumerable<ProjectTeam>
@{ ViewData["Title"] = "Project team finder"; var recommended = ViewBag.Recommended as HashSet<int> ?? new(); }
<div class="page-head"><div><div class="eyebrow">BUILD TOGETHER</div><h1>Project team finder</h1><p>Find collaborators whose skills complement yours.</p></div><a class="btn btn-primary" asp-action="Create">＋ Post a project</a></div>
<div class="row g-3">@foreach(var t in Model) { <div class="col-md-6"><div class="content-card h-100">@if(recommended.Contains(t.Id)) { <span class="pill pill-green">✦ Recommended for you</span> }<h5 class="mt-3">@t.ProjectTitle</h5><p>@t.Description</p><div class="skill-tags">@foreach(var s in t.RequiredSkills.Split(',',StringSplitOptions.RemoveEmptyEntries)) { <span>@s.Trim()</span> }</div><div class="d-flex justify-content-between mt-4"><small class="muted">@t.Department · @t.MembersNeeded openings</small><small class="muted">By @t.OwnerName</small></div></div></div> }</div>
@if(!Model.Any()) { <div class="empty-card">No teams yet. Share your project idea.</div> }
