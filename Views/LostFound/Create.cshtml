@model LostFoundInput
@{ ViewData["Title"] = "Report item"; }
<div class="form-shell"><h1>Report an item</h1><form method="post"><label asp-for="ItemName" class="form-label"></label><input asp-for="ItemName" class="form-control mb-3"/><label asp-for="Status" class="form-label"></label><select asp-for="Status" class="form-select mb-3"><option>Lost</option><option>Found</option></select><label asp-for="Location" class="form-label"></label><input asp-for="Location" class="form-control mb-3"/><label asp-for="Details" class="form-label"></label><textarea asp-for="Details" class="form-control mb-3"></textarea><label asp-for="ContactInfo" class="form-label">Contact email</label><input asp-for="ContactInfo" class="form-control mb-3"/><button class="btn btn-primary">Submit report</button></form></div>
