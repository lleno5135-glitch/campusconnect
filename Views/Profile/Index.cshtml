@model ProfileInput
@{ ViewData["Title"] = "My profile"; }
<div class="form-shell"><div class="eyebrow">YOUR CAMPUS IDENTITY</div><h1>My profile</h1><p class="muted">Add your skills and interests to improve team and event recommendations.</p><form method="post"><label asp-for="FullName" class="form-label"></label><input asp-for="FullName" class="form-control mb-3"/><label asp-for="Department" class="form-label"></label><input asp-for="Department" class="form-control mb-3"/><label asp-for="YearOfStudy" class="form-label">Year of study</label><input asp-for="YearOfStudy" class="form-control mb-3" placeholder="Final year"/><label asp-for="Skills" class="form-label">Skills (comma separated)</label><input asp-for="Skills" class="form-control mb-3" placeholder="C#, Figma, SQL"/><label asp-for="Interests" class="form-label">Interests (comma separated)</label><input asp-for="Interests" class="form-control mb-3" placeholder="AI, design, events"/><label asp-for="Bio" class="form-label"></label><textarea asp-for="Bio" class="form-control mb-3"></textarea><button class="btn btn-primary">Save profile</button></form></div>
