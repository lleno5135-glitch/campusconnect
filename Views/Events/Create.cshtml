@model EventInput
@{ ViewData["Title"] = "Add event"; }
<div class="form-shell"><h1>Add campus event</h1><form method="post"><label class="form-label" asp-for="Title"></label><input asp-for="Title" class="form-control mb-3"/><label class="form-label" asp-for="Description"></label><textarea asp-for="Description" class="form-control mb-3"></textarea><label class="form-label" asp-for="Venue"></label><input asp-for="Venue" class="form-control mb-3"/><label class="form-label" asp-for="StartsAt"></label><input asp-for="StartsAt" type="datetime-local" class="form-control mb-3"/><button class="btn btn-primary">Save event</button></form></div>
