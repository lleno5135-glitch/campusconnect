@model IEnumerable<Announcement>
@{ ViewData["Title"] = "Admin dashboard"; }
<div class="page-head"><div><div class="eyebrow">CAMPUS CONTROL CENTER</div><h1>Admin dashboard</h1><p>Overview and campus-wide communication.</p></div><a class="btn btn-primary" asp-action="Announcement">＋ New announcement</a></div>
<div class="row g-3 mb-4"><div class="col-6 col-lg-3"><div class="stat-card"><span>Users</span><strong>@ViewBag.Users</strong></div></div><div class="col-6 col-lg-3"><div class="stat-card"><span>Posts</span><strong>@ViewBag.Posts</strong></div></div><div class="col-6 col-lg-3"><div class="stat-card"><span>Resources</span><strong>@ViewBag.Resources</strong></div></div><div class="col-6 col-lg-3"><div class="stat-card"><span>Events</span><strong>@ViewBag.Events</strong></div></div></div>
<div class="content-card"><h4>Announcements</h4>@foreach(var a in Model) { <div class="notice-item d-flex justify-content-between gap-3"><div><b>@a.Title</b><p class="muted mb-0">@a.Message</p></div><form asp-action="DeleteAnnouncement" method="post"><input type="hidden" name="id" value="@a.Id"/><button class="btn btn-sm btn-outline-danger">Delete</button></form></div> }</div>
