@model Announcement
@{ ViewData["Title"] = "New announcement"; }
<div class="form-shell"><h1>New announcement</h1><form method="post"><label asp-for="Title" class="form-label"></label><input asp-for="Title" class="form-control mb-3"/><label asp-for="Message" class="form-label"></label><textarea asp-for="Message" class="form-control mb-3" rows="5"></textarea><button class="btn btn-primary">Publish announcement</button></form></div>
